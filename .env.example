# Backend
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/bookmyappointment
JWT_SECRET=replace-this-with-a-long-random-secret
ADMIN_SIGNUP_KEY=replace-this-with-a-private-random-setup-key
JWT_EXPIRES_IN=7d
MAX_UPLOAD_MB=10
APPOINTMENT_START_TIME=09:00
APPOINTMENT_END_TIME=18:00
APPOINTMENT_LUNCH_START=13:00
APPOINTMENT_LUNCH_END=14:00
APPOINTMENT_SLOT_MINUTES=15

# Local-only symptom RAG models served by Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_REQUEST_TIMEOUT_MS=120000
OLLAMA_AUTO_EMBED=false
DEMO_PASSWORD=
ENABLE_DEMO_SEED=false
